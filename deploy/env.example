# /opt/agent-loop/env — секреты. НЕ коммитить (chmod 600).
# Токен Forgejo пользователя hermes (create: Settings -> Applications / Access tokens)
FORGEJO_TOKEN=
# JWT Honcho (workspace hermes, без exp). Генерация:
#   cd /home/user/honcho && uv run python -c 'from src.security import JWTParams,create_jwt; print(create_jwt(JWTParams(t="", w="hermes")))'
HONCHO_API_KEY=
# опционально, для внешних моделей
OPENAI_API_KEY=
# llama.cpp ключи (110.3 / 110.4). Копируются из /home/user/.llama-api-key на хосте
LLAMA_API_KEY=
LLAMA_P40_API_KEY=
# адрес Forgejo для проверки сессии панели (по умолчанию http://127.0.0.1:3000)
#FORGEJO_INTERNAL_URL=http://127.0.0.1:3000
